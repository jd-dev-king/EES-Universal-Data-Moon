# Frontend / AI
OPENAI_API_KEY=
EES_AI_MODEL=gpt-5-mini

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ees_data_platform
EES_REGISTRY_DATABASE_URL=

# MongoDB
EES_MONGODB_URL=mongodb://127.0.0.1:27017
EES_MONGODB_DATABASE=ees_documents

# Universal Ingest Gateway
EES_INGEST_API_KEY=
EES_INGEST_REQUIRE_REGISTRY=true

# CORS / deployment
EES_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420
